# Create a Firebase project, enable Email/Password and Google sign-in,
# then copy the web app configuration here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Phase 2/3: deployed Socket.IO signaling service URL
NEXT_PUBLIC_SIGNALING_URL=


# Phase 4 Web Push
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_firebase_web_push_certificate_key
FIREBASE_ADMIN_PROJECT_ID=your_firebase_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-...@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: use your stable production URL for notification-click navigation.
NEXT_PUBLIC_APP_URL=https://your-callio-domain.vercel.app

# Strongly recommended for calls across restrictive mobile networks.
# Use a TURN provider that issues time-limited credentials where possible.
NEXT_PUBLIC_TURN_URL=turns:your-turn-host:5349
NEXT_PUBLIC_TURN_USERNAME=your-temporary-turn-username
NEXT_PUBLIC_TURN_CREDENTIAL=your-temporary-turn-credential
